# Caladan LDAP Configuration for Authentik

# The URL of your Authentik LDAP outpost (e.g., ldap://192.168.1.10:3389)
LDAP_SERVER=ldap://<AUTHENTIK_IP>:3389

# The Base DN as configured in the Authentik LDAP Provider
LDAP_BASE_DN=dc=ldap,dc=goauthentik,dc=io

# The DN of the service account/user used to bind and search
LDAP_BIND_DN=cn=caladan_svc,ou=users,dc=ldap,dc=goauthentik,dc=io

# The password for the bind user
LDAP_BIND_PASSWORD=your_service_account_password

# Filter used to find the user. {0} is replaced by the login username.
LDAP_USER_FILTER=(cn={0})

# Enable verbose logging for LDAP operations (true/false)
LDAP_VERBOSE=false

# --- Default User Configuration ---
# Enable or disable the built-in fallback user (true/false)
ENABLE_DEFAULT_USER=true
# Username for the fallback user
DEFAULT_USER=user
# Password for the fallback user
DEFAULT_PASSWORD=password

